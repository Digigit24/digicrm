# digicrm environment example
#
# Copy the values you need into digicrm/.env (which is git-ignored).
# Only the AI copilot variables are documented here; other runtime config
# (DATABASE_URL, JWT secret, etc.) lives in your real .env.

# ─── AI Copilot (Phase 1: text streaming) ────────────────────────────────────
# Provider fallback order: Kimi/Moonshot → OpenAI → Gemini → Grok/xAI.
# Leave all blank to get the graceful "AI provider not configured" response.

# PRIMARY — Kimi / Moonshot (OpenAI-compatible)
MOONSHOT_API_KEY=
# Optional overrides:
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# MOONSHOT_MODEL=kimi-k2-0905-preview

# MULTIMODAL / fallback — OpenAI (image + Whisper are Phase 2)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# FALLBACK — Google Gemini (thin REST adapter)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# FALLBACK — Grok / xAI (OpenAI-compatible)
XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-2-latest

# ─── AI Copilot (Phase 2a: CRM tool-calling) ─────────────────────────────────
# Master kill-switch for tool-calling. false → text-only Phase-1 behavior.
AI_TOOLS_ENABLED=true
# Max LLM⇄tool round-trips per request (runaway-loop guard).
AI_MAX_TOOL_ITERS=5
# Base URL the tool executor uses to re-call our OWN REST API, forwarding the
# caller's JWT (so tenant + RBAC are inherited). Point at this digicrm instance.
AI_INTERNAL_BASE_URL=http://127.0.0.1:8001

# TeleCMI and Zata secrets are envelope-encrypted with this stable master key.
# Generate it once with Fernet.generate_key() and use the same value in every
# backend instance connected to this database. Never rotate it casually.
TELECMI_MASTER_KEY=

# Absolute path to a Firebase service-account JSON file. Enables call
# wake-up pushes to backgrounded mobile SIP clients. Leave unset until a
# Firebase project exists for this app — push_service.py no-ops without it.
FIREBASE_CREDENTIALS_JSON=

# The webhook is the primary call-log sync path. Celery handles the finite
# one-minute post-call reconciliation, archive retries, and five-minute backfill.
# Both worker and beat must be running against the same Redis broker.
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ─── Pusher (real-time telephony live events) ────────────────────────────────
# Same Pusher app the frontend already uses for chat (key/cluster hardcoded
# there as 649db422ae8f2e9c7a9d / ap2) — get PUSHER_APP_ID and PUSHER_SECRET
# from that app's dashboard. Leave PUSHER_SECRET blank to disable (safe no-op).
PUSHER_APP_ID=
PUSHER_SECRET=
# Only override these if you intentionally point at a DIFFERENT Pusher app
# than the one the frontend subscribes to (you'd need to update the frontend
# hardcoded values too in that case):
# PUSHER_KEY=649db422ae8f2e9c7a9d
# PUSHER_CLUSTER=ap2

# ─── CRM reminders and notifications ────────────────────────────────────────
# Redis-backed Celery worker + beat must both be running. One beat task scans
# due reminders every 30 seconds; reminders do not create individual cron jobs.
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# REMINDER_DELIVERY_GRACE_HOURS=24
# REMINDER_MAX_ATTEMPTS=5

# The frontend uses the same Pusher key/cluster above for instant notification
# refresh. If Pusher is unavailable, its 30-second REST polling remains active.

# ─── Composio (third-party tool connections) ─────────────────────────────────
# Server-side ONLY. This key grants access to every connected account for every
# tenant — never expose it to the browser, never commit it. Get it from
# https://app.composio.dev settings.
COMPOSIO_API_KEY=
COMPOSIO_ENABLED=false
# MUST be unique per environment — it namespaces Composio entity ids
# ("{namespace}:{tenant_id}:{user_id}") so a staging box can never address a
# production tenant's connected accounts.
COMPOSIO_USER_NAMESPACE=celiyo-dev
COMPOSIO_CALLBACK_URL=http://localhost:8000/api/integrations/composio/callback/
COMPOSIO_FRONTEND_RETURN_URL=http://localhost:3000/integrations/composio/callback
# From composio.triggers.set_webhook_subscription()['secret'] — leave blank to
# reject all inbound Composio webhooks (safe default).
COMPOSIO_WEBHOOK_SECRET=
# POST /composio/connections/{id}/execute/ ships dark; leave false.
COMPOSIO_EXECUTE_ENABLED=false
