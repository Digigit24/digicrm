# DigiCRM MCP Server — required environment variables
# Copy to .env and fill in your values before starting the MCP server.

# DigiCRM Django API
DIGICRM_BASE_URL=http://localhost:8000
DIGICRM_JWT_TOKEN=your-jwt-token-here
DIGICRM_TENANT_ID=your-tenant-uuid-here

# WhatsApp vendor credentials (from Laravel WhatsApp admin panel)
# These are injected as headers when digicrm calls the Laravel adapter.
WA_VENDOR_UID=your-vendor-uid
WA_API_TOKEN=your-api-token
WA_BASE_URL=https://whatsappapi.celiyo.com/api

# HTTP MCP endpoint (POST /mcp/sse) — REQUIRED
# The server FAILS CLOSED: if MCP_SECRET is empty every request is rejected
# with 401. Send it as "Authorization: Bearer <MCP_SECRET>"; the ?secret= query
# parameter was removed on 2026-08-19 and is no longer accepted.
MCP_SECRET=generate-a-long-random-value
# Service account every MCP write is attributed to.
MCP_OWNER_USER_ID=your-service-user-uuid

# Optional
MCP_LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call /mcp/*. Leave unset to use the
# built-in default (claude.ai + celiyo.com). Server-to-server clients send no
# Origin header and are unaffected by this.
# MCP_ALLOWED_ORIGINS=https://claude.ai,https://crm.celiyo.com
