# .env.production -- digicrm production template.
# NO REAL SECRETS IN THIS FILE. Values marked <set-in-deploy> are injected by
# the deployment environment (systemd EnvironmentFile / secret manager) and are
# never committed. This file documents the required key set.
#
# NOTE: settings.py resolves DJANGO_ENV_FILE > .env.local > .env. A production
# host must have NO .env.local, or it silently wins over this file.
DEBUG=False
ALLOWED_HOSTS=crm.celiyo.com
SECRET_KEY=<set-in-deploy>
DATABASE_URL=<set-in-deploy>
JWT_SECRET_KEY=<set-in-deploy>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://crm.celiyo.com,https://admin.celiyo.com
CSRF_TRUSTED_ORIGINS=https://crm.celiyo.com,https://admin.celiyo.com
SUPERADMIN_URL=https://admin.celiyo.com
MCP_SECRET=<set-in-deploy — ROTATE: the old value is in git history>
MCP_ALLOWED_ORIGINS=https://claude.ai,https://crm.celiyo.com
COMPOSIO_API_KEY=<set-in-deploy>
COMPOSIO_USER_NAMESPACE=celiyo-prod
WA_VENDOR_UID=<set-in-deploy>
WA_API_TOKEN=<set-in-deploy>
