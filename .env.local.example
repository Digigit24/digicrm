# Copy to .env.local for local development. Localhost only; never deployed.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,digitech.tail7572d2.ts.net
DATABASE_URL=sqlite:///dev-local.sqlite3
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://digitech.tail7572d2.ts.net:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://digitech.tail7572d2.ts.net:5173
SUPERADMIN_URL=http://127.0.0.1:8000
# Service JWT for the tenant user directory. Mint one from superadmin for a
# super-admin user; without it GET /api/crm/users/ fails closed with 503.
MCP_SERVICE_JWT=
JWT_SECRET_KEY=<must match superadmin's JWT_SECRET_KEY>
